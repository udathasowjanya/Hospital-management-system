-- 2. Display appointments with patient and doctor names
SELECT 
    p.FirstName AS PatientName,
    d.FirstName AS DoctorName,
    a.ApptDate,
    a.Status
FROM Appointment a
JOIN Patient p ON a.PatientID = p.PatientID
JOIN Doctor d ON a.DoctorID = d.DoctorID;

